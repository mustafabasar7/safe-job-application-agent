# Copy this file to .env. Never commit .env.
# Built-in providers: gemini, openai_compatible.
MODEL_PROVIDER=gemini
MODEL_API_KEY=
MODEL_NAME=gemini-3.6-flash
MODEL_DAILY_REQUEST_LIMIT=900

# Required only for openai_compatible (for example DeepSeek or a local server).
# Remote endpoints must use HTTPS; local HTTP endpoints may use localhost/127.0.0.1.
MODEL_BASE_URL=https://api.deepseek.com

# Provider-specific key variables are accepted as fallbacks when MODEL_API_KEY is empty.
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Paths are intentionally empty and must point to local, ignored files.
CANDIDATE_PROFILE_PATH=
JOBS_CONFIG_PATH=

BROWSER_PROVIDER=playwright_cli
PLAYWRIGHT_CLI=playwright-cli
PLAYWRIGHT_SESSION=job-agent
PLAYWRIGHT_HEADLESS=false
JOB_AGENT_MAX_STEPS=30
