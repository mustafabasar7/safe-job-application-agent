# Copy this file to .env. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_DAILY_REQUEST_LIMIT=900

# Paths are intentionally empty and must point to local, ignored files.
CANDIDATE_PROFILE_PATH=
JOBS_CONFIG_PATH=

PLAYWRIGHT_CLI=playwright-cli
PLAYWRIGHT_SESSION=job-agent
PLAYWRIGHT_HEADLESS=false
JOB_AGENT_MAX_STEPS=30
